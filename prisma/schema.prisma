// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CommentAnchorType {
  BLOCK
  SHAPE
}

// What an organization member can do in a workspace. Creators and org admins are always owners, so this
// only describes everyone else. A VIEWER can read and comment but can't change anything.
enum WorkspaceRole {
  EDITOR
  VIEWER
}

enum WorkspaceStatus {
  PLANNING
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum VersionKind {
  MANUAL
  AUTO
  BEFORE_RESTORE
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  name      String?
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  
  createdWorkspaces Workspace[]
  agentPrompts      AgentPrompt[]
  createdVersions   WorkspaceVersion[]
  createdTemplates  WorkspaceTemplate[]
  comments          Comment[]          @relation("CommentAuthor")
  resolvedComments  Comment[]          @relation("CommentResolver")
  commentMentions   CommentMention[]
  workspaceAccess   WorkspaceAccess[]
  activity          ActivityEvent[]
  notifications     Notification[]     @relation("NotificationRecipient")
  actedNotifications Notification[]    @relation("NotificationActor")
}

model Workspace {
  id          String          @id @default(cuid())
  name        String
  description String?
  creatorId   String

  clerkOrgId  String?
  status      WorkspaceStatus @default(PLANNING)
  position    Float           @default(0)

  shareToken  String?         @unique
  deletedAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  creator      User          @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  doc          Doc?
  canvas       Canvas?
  agentPrompts AgentPrompt[]
  versions     WorkspaceVersion[]
  comments     Comment[]
  memberRole   WorkspaceRole @default(EDITOR)
  access       WorkspaceAccess[]
  activity     ActivityEvent[]
  notifications Notification[]

  @@index([creatorId])
  @@index([clerkOrgId])
}

model Doc {
  id          String   @id @default(cuid())
  workspaceId String   @unique
  // BlockNote block JSON — a readable copy for server-side features (agent, share view).
  content     Json?
  // Yjs document state — the real-time collaboration source of truth.
  yjsState    Bytes?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Canvas {
  id          String   @id @default(cuid())
  workspaceId String   @unique
  // tldraw shape/store snapshot.
  content     Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model AgentPrompt {
  id          String   @id @default(cuid())
  // Who the prompt counts against: the workspace's Clerk org id, or the Clerk user id for a
  // personal workspace. Clerk prefixes ids ("org_", "user_"), so the two never collide.
  ownerId     String
  userId      String
  workspaceId String?
  createdAt   DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([ownerId, createdAt])
}


model WorkspaceVersion {
  id            String      @id @default(cuid())
  workspaceId   String
  kind          VersionKind
  // Name typed by the user; null for automatic versions.
  label         String?
  // Short text excerpt and shape count, so the history list doesn't have to load full content.
  preview       String?
  shapeCount    Int         @default(0)
  // BlockNote block JSON and tldraw snapshot, copied from Doc.content / Canvas.content.
  docContent    Json?
  canvasContent Json?
  createdById   String?
  createdAt     DateTime    @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
}


model WorkspaceTemplate {
  id            String   @id @default(cuid())
  name          String
  description   String?
  // Same ownership rule as workspaces: an organization's shared templates, or a solo user's own.
  clerkOrgId    String?
  creatorId     String
  // BlockNote block JSON and tldraw snapshot, copied from Doc.content / Canvas.content.
  docContent    Json?
  canvasContent Json?
  createdAt     DateTime @default(now())

  creator User @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([clerkOrgId])
  @@index([creatorId])
}


model Comment {
  id           String             @id @default(cuid())
  workspaceId  String
  authorId     String
  parentId     String?
  // Plain text. @mentions are stored as @[Name](userId) tokens (see lib/comment-body.ts).
  body         String
  // Optional attachment, best effort: the block or shape may be deleted later.
  anchorType   CommentAnchorType?
  anchorId     String?
  // Set on a thread's top-level comment when it's resolved.
  resolvedAt   DateTime?
  resolvedById String?
  createdAt    DateTime           @default(now())
  editedAt     DateTime?

  workspace  Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author     User             @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  resolvedBy User?            @relation("CommentResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  parent     Comment?         @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    Comment[]        @relation("CommentReplies")
  mentions   CommentMention[]

  @@index([workspaceId, createdAt])
  @@index([parentId])
}


model CommentMention {
  commentId String
  userId    String
  readAt    DateTime?

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@index([userId, readAt])
}

// A per-person role that overrides Workspace.memberRole, for org workspaces.
model WorkspaceAccess {
  workspaceId String
  userId      String
  role        WorkspaceRole

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
}

// Who did what in a workspace, for the Activity panel. Meaningful events only (see lib/activity.ts);
// doc and canvas edits are not logged because they would drown everything else out.
model ActivityEvent {
  id          String   @id @default(cuid())
  workspaceId String
  // Null when the person's account was deleted.
  actorId     String?
  // An ActivityType from lib/activity.ts. A string, so new kinds don't need a migration.
  type        String
  // Small details for the sentence ("from" / "to" names, a label...). Never comment text.
  data        Json?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
}

// Something that happened that one person should know about (a reply to their comment, a role change...).
// Mentions are not here: they live in CommentMention and the bell merges both.
model Notification {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  actorId     String?
  // A NotificationType from lib/notification-store.ts.
  type        String
  data        Json?
  createdAt   DateTime  @default(now())
  readAt      DateTime?

  user      User      @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}