// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceStatus {
  PLANNING
  IN_PROGRESS
  IN_REVIEW
  DONE
}

// Where a saved version came from. Only MANUAL ones are kept forever; the other two are pruned
// to the newest few per workspace (see actions/version.ts).
enum VersionKind {
  MANUAL
  AUTO
  BEFORE_RESTORE
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  name      String?
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Workspaces this user created — membership/roles for all workspaces live in Clerk Organizations,
  // not here, so this is just "who to blame/bill" rather than an access-control source of truth.
  createdWorkspaces Workspace[]
  agentPrompts      AgentPrompt[]
  createdVersions   WorkspaceVersion[]
}

model Workspace {
  id          String          @id @default(cuid())
  name        String
  description String?
  creatorId   String
  // Clerk Organization id — the membership/role source of truth (org:admin, org:member,
  // org:viewer). One org can own many workspaces (not unique); nullable because a solo user's
  // personal workspace has no org behind it under Membership-optional mode.
  clerkOrgId  String?
  // Dashboard kanban column + order within it. position is a float so a dropped card can
  // take the midpoint between its neighbors — only the moved card ever gets written.
  status      WorkspaceStatus @default(PLANNING)
  position    Float           @default(0)
  // Public read-only link token; null means sharing is off. Resetting it kills old links.
  shareToken  String?         @unique
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  creator      User          @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  // Every workspace is always exactly one doc + one canvas, paired — not a generic list of
  // surfaces. Both are created alongside the workspace itself.
  doc          Doc?
  canvas       Canvas?
  agentPrompts AgentPrompt[]
  versions     WorkspaceVersion[]

  @@index([creatorId])
  @@index([clerkOrgId])
}

model Doc {
  id          String   @id @default(cuid())
  workspaceId String   @unique
  // BlockNote block JSON — a readable copy for server-side features (agent, share view).
  content     Json?
  // Yjs document state — the real-time collaboration source of truth.
  yjsState    Bytes?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Canvas {
  id          String   @id @default(cuid())
  workspaceId String   @unique
  // tldraw shape/store snapshot.
  content     Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// One row per prompt a user sends to the agent, counted per owner each month for usage limits.
// Rows outlive their workspace (SetNull), so deleting a workspace can't reset usage.
model AgentPrompt {
  id          String   @id @default(cuid())
  // Who the prompt counts against: the workspace's Clerk org id, or the Clerk user id for a
  // personal workspace. Clerk prefixes ids ("org_", "user_"), so the two never collide.
  ownerId     String
  userId      String
  workspaceId String?
  createdAt   DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([ownerId, createdAt])
}


// A saved copy of a workspace's doc and canvas that can be restored later. Restoring never reads
// Yjs history: it pushes this content back through the live editors, so collaborators see it too.
model WorkspaceVersion {
  id            String      @id @default(cuid())
  workspaceId   String
  kind          VersionKind
  // Name typed by the user; null for automatic versions.
  label         String?
  // Short text excerpt and shape count, so the history list doesn't have to load full content.
  preview       String?
  shapeCount    Int         @default(0)
  // BlockNote block JSON and tldraw snapshot, copied from Doc.content / Canvas.content.
  docContent    Json?
  canvasContent Json?
  createdById   String?
  createdAt     DateTime    @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
}